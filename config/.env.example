# --- JAC B2B (b2b-jac.com) настройки ---
# Скопируй этот файл в config/.env и заполни ОДИН недостающий пункт: JAC_LOGIN.

JAC_BASE_URL=https://b2b-jac.com

# Способ 1 (основной): логин + пароль.
# Пароль уже известен. Впиши свой ЛОГИН от B2B-портала (телефон/почта/код дилера).
JAC_LOGIN=
JAC_PASSWORD=

# Способ 2 (резерв): если логин неизвестен/неудобен — вставь cookie уже
# залогиненной сессии из браузера (DevTools → Application → Cookies → b2b-jac.com).
# Достаточно строки вида:  PHPSESSID=xxxx; BITRIX_SM_LOGIN=yyyy; ...
# Если JAC_COOKIE заполнен — он имеет приоритет над логином/паролем.
JAC_COOKIE=

# Страница-источник прайса со складом (бланк заказа). Можно указать несколько
# через запятую. Команда discover поможет найти правильные, если эта изменится.
JAC_BLANK_PATHS=/orders/blank_zakaza/000000002/

# Каталог (на случай, если бланк не покрывает всю номенклатуру).
JAC_CATALOG_PATH=/catalog/

# Каталог вывода и формат(ы): csv,xlsx,json
JAC_OUTPUT_DIR=data
JAC_OUTPUT_FORMATS=csv,json,xlsx

# Сетевые настройки
JAC_TIMEOUT=30
JAC_RETRIES=2
JAC_USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36
